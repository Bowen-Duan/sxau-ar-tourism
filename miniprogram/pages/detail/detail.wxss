/* pages/detail/detail.wxss 按设计稿重写 */
/* 主色（金）：#c4a574；标题黑：#1a1a1a；正文：#333；次要：#666；标签灰：#999；页面底：#f5f5f5 */

.detail-page {
  min-height: 100vh;
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif !important;
}

text,
view,
button,
input,
textarea {
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif !important;
}

/* ===== 加载中 ===== */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0e6d2;
  border-top-color: #c4a574;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* ===== 加载失败 ===== */
.error-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  padding: 0 40rpx;
}
.error-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.error-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
  text-align: center;
}
.retry-btn {
  background: #c4a574;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
}
.retry-btn::after {
  border: none;
}

/* ===== 顶部大图（沉浸式，约35%屏高） ===== */
.hero-section {
  position: relative;
  width: 100%;
  height: 560rpx;
}
.hero-swiper {
  width: 100%;
  height: 100%;
}
.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}
.hero-top-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 180rpx;
  background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0) 100%);
  pointer-events: none;
}

/* 半透明返回按钮（top 由内联样式按状态栏高度定位） */
.nav-back {
  position: absolute;
  left: 24rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  backdrop-filter: blur(10rpx);
  z-index: 10;
}
.nav-back-icon {
  font-size: 56rpx;
  color: #ffffff;
  line-height: 1;
  margin-top: -8rpx;
  font-weight: 300;
}

/* ===== 白色圆角信息卡片（悬浮于图片上约24px） ===== */
.info-card {
  position: relative;
  margin: -48rpx 24rpx 0;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx 32rpx 32rpx;
  z-index: 5;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.08);
}

/* ===== 标题：中文 + 英文 ===== */
.title-section {
  display: block;
}
.spot-name {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 1rpx;
  line-height: 1.4;
  margin-bottom: 10rpx;
}
.spot-en {
  display: block;
  font-size: 28rpx;
  color: #666;
  letter-spacing: 0.3rpx;
  line-height: 1.55;
  font-weight: 400;
}

/* ===== 三个功能按钮（圆形描边 + 灰色文字标签） ===== */
.action-row {
  display: flex;
  justify-content: space-around;
  padding: 44rpx 20rpx 0;
}
.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.action-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 2rpx solid #c4a574;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  transition: all 0.3s;
}
.action-circle.playing,
.action-circle.active {
  border-color: #b08d58;
  background: #faf6ee;
}
.action-text {
  font-size: 24rpx;
  color: #666;
  letter-spacing: 1rpx;
  font-weight: 400;
}

/* ===== 线性描边图标（金色） ===== */
.line-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

/* 耳机（语音导览） */
.headphone .gh-arc {
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 18rpx;
  border: 2rpx solid #c4a574;
  border-bottom: none;
  border-radius: 32rpx 32rpx 0 0;
}
.headphone .gh-ear-l {
  position: absolute;
  bottom: 8rpx;
  left: 4rpx;
  width: 7rpx;
  height: 11rpx;
  background: #c4a574;
  border-radius: 2rpx;
}
.headphone .gh-ear-r {
  position: absolute;
  bottom: 8rpx;
  right: 4rpx;
  width: 7rpx;
  height: 11rpx;
  background: #c4a574;
  border-radius: 2rpx;
}
.headphone.active .gh-arc {
  border-color: #b08d58;
}
.headphone.active .gh-ear-l,
.headphone.active .gh-ear-r {
  background: #b08d58;
}

/* 地球（VR漫游） */
.globe .gg-circle {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #c4a574;
  border-radius: 50%;
}
.globe .gg-horiz {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 34rpx;
  height: 2rpx;
  background: #c4a574;
}
.globe .gg-vert {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 2rpx;
  height: 34rpx;
  background: #c4a574;
}

/* 定位（景点导航） */
.location .lg-pin {
  position: absolute;
  top: 4rpx;
  left: 50%;
  width: 24rpx;
  height: 30rpx;
  border: 2rpx solid #c4a574;
  border-radius: 24rpx 24rpx 24rpx 4rpx;
  transform: translateX(-50%) rotate(-45deg);
}
.location .lg-dot {
  position: absolute;
  top: 13rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  background: #c4a574;
  border-radius: 50%;
}

/* ===== 中/EN 语言切换（右对齐胶囊，选中金色） ===== */
.lang-switch-row {
  display: flex;
  justify-content: flex-end;
  padding: 32rpx 0 4rpx;
}
.lang-switch {
  display: flex;
  align-items: center;
  background: #f0f0f0;
  border-radius: 28rpx;
  padding: 4rpx;
  flex-shrink: 0;
}
.lang-btn {
  font-size: 22rpx;
  color: #999;
  padding: 6rpx 28rpx;
  border-radius: 24rpx;
  font-weight: 400;
  transition: all 0.3s;
}
.lang-btn.active {
  background: #c4a574;
  color: #ffffff;
  font-weight: 600;
}

/* ===== 内嵌地图（景点导航展开） ===== */
.map-section {
  margin: 28rpx 0 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
}
.map-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #ffffff;
}
.map-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}
.map-close {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.close-icon {
  font-size: 26rpx;
  color: #999;
}
.spot-map {
  width: 100%;
  height: 360rpx;
}
.map-info {
  padding: 16rpx 20rpx;
  background: #ffffff;
}
.map-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}
.map-address {
  display: block;
  font-size: 22rpx;
  color: #888;
  margin-bottom: 16rpx;
}
.map-actions {
  display: flex;
  gap: 12rpx;
}
.map-btn {
  flex: 1;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 10rpx;
  font-size: 22rpx;
}
.map-btn.primary {
  background: #c4a574;
  color: #ffffff;
}

/* ===== 基本信息：标签左 + 内容右，上下细分割线 ===== */
.info-section {
  margin-top: 32rpx;
  border-top: 1rpx solid #eee;
  border-bottom: 1rpx solid #eee;
}
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
}
.info-row + .info-row {
  border-top: 1rpx solid #f2f2f2;
}
.info-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #999;
  letter-spacing: 1rpx;
  font-weight: 400;
}
.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  letter-spacing: 0.5rpx;
  font-weight: 400;
}

/* ===== 历史人物（入口保持不变） ===== */
.person-section {
  padding: 0;
  background: #ffffff;
  margin-top: 32rpx;
}
.person-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 2rpx;
  margin-bottom: 28rpx;
}
.person-avatar-list {
  display: flex;
  flex-wrap: wrap;
  gap: 36rpx;
  padding-bottom: 16rpx;
}
.person-avatar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 110rpx;
}
.person-avatar-circle {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f0f0f0;
  margin-bottom: 12rpx;
}
.person-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
.person-avatar-name {
  font-size: 24rpx;
  color: #333;
  text-align: center;
  letter-spacing: 1rpx;
  font-weight: 400;
}

/* ===== 建筑介绍（富文本） ===== */
.content-section {
  padding: 32rpx 0 8rpx;
  border-top: 1rpx solid #f2f2f2;
  margin-top: 32rpx;
}
.rich-content {
  font-size: 26rpx;
  color: #555;
  line-height: 1.8;
  letter-spacing: 0.5rpx;
}
.rich-content /deep/ img {
  max-width: 100% !important;
  border-radius: 10rpx;
  margin: 12rpx 0;
}
.rich-content /deep/ p {
  margin-bottom: 16rpx;
}

/* ===== 底部留白 ===== */
.bottom-space {
  height: 60rpx;
  background: #f5f5f5;
}

/* ===== 底部音频面板（金色渐变 + 白字） ===== */
.has-audio-panel {
  padding-bottom: 220rpx;
}
.audio-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: linear-gradient(135deg, #dcb87f 0%, #c4a574 55%, #b08d58 100%);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 32rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 30rpx rgba(0, 0, 0, 0.15);
}
.audio-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.audio-panel-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
}
.audio-panel-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.audio-panel-close-icon {
  font-size: 24rpx;
  color: #5a4320;
  line-height: 1;
}
.audio-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}
.audio-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.audio-item-name {
  font-size: 28rpx;
  font-weight: 400;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.audio-item-toggle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  flex-shrink: 0;
}
.audio-item-toggle-icon {
  font-size: 26rpx;
  color: #5a4320;
  line-height: 1;
}
