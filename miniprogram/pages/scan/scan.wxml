<view class="page">
  <!-- 未选图：引导区 -->
  <view wx:if="{{!imagePath}}" class="guide">
    <view class="guide-icon">📷</view>
    <view class="guide-title">对准建筑拍照识别</view>
    <view class="guide-tip">拍照时请放大单个建筑或建筑门牌、铜牌、相关文创产品也行哟！</view>
    <view class="guide-btns">
      <view class="btn btn-primary" bindtap="takePhoto">
        <text class="btn-icon">📷</text>
        <text>拍照</text>
      </view>
      <view class="btn btn-ghost" bindtap="chooseAlbum">
        <text class="btn-icon">🖼</text>
        <text>从相册选择</text>
      </view>
    </view>
  </view>

  <!-- 已选图：预览 + 识别结果 -->
  <block wx:else>
    <view class="preview-card">
      <image class="preview-img" src="{{imagePath}}" mode="aspectFill" />
      <view class="preview-actions">
        <view class="action-btn" bindtap="reset">重新选择</view>
        <view class="action-btn action-primary" bindtap="doScan" data-path="{{imagePath}}" wx:if="{{!scanning}}">重新识别</view>
      </view>
    </view>

    <!-- 识别中 -->
    <view wx:if="{{scanning}}" class="status-card">
      <view class="spinner"></view>
      <text class="status-text">正在识别中，请稍候…</text>
    </view>

    <!-- 识别成功：准确识别出建筑 -->
    <view wx:elif="{{resultCode === 1 && spot}}" class="result-card result-success">
      <view class="result-badge result-badge-ok">✓ 识别成功</view>
      <image class="spot-img" src="{{spot.pictureUrl || spot.backgroundCover}}" mode="aspectFill" />
      <view class="spot-info">
        <text class="spot-name">{{spot.name}}</text>
        <text wx:if="{{spot.englishName}}" class="spot-en">{{spot.englishName}}</text>
        <view wx:if="{{spot.address}}" class="spot-meta">
          <text class="meta-label">地址</text>
          <text class="meta-value">{{spot.address}}</text>
        </view>
        <text wx:if="{{spot.introduction}}" class="spot-intro">{{spot.introduction}}</text>
        <view class="spot-actions">
          <view class="detail-btn" data-id="{{spot.id}}" bindtap="viewDetail">查看详情</view>
        </view>
      </view>
    </view>

    <!-- 未识别：推荐建筑列表 -->
    <view wx:elif="{{resultCode === 2}}" class="result-card">
      <view class="result-badge result-badge-warn">未准确识别，为您推荐以下建筑</view>
      <view wx:if="{{recommends.length}}" class="recommend-list">
        <view
          class="recommend-item"
          wx:for="{{recommends}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="goRecommend"
        >
          <image class="recommend-img" src="{{item.pictureUrl || item.backgroundCover}}" mode="aspectFill" />
          <view class="recommend-info">
            <text class="recommend-name">{{item.name}}</text>
            <text wx:if="{{item.englishName}}" class="recommend-en">{{item.englishName}}</text>
            <text wx:if="{{item.address}}" class="recommend-addr">{{item.address}}</text>
          </view>
          <text class="recommend-arrow">›</text>
        </view>
      </view>
      <view wx:else class="recommend-empty">暂无推荐建筑</view>
      <view class="retry-row">
        <view class="action-btn action-primary" bindtap="reset">换一张图片</view>
      </view>
    </view>

    <!-- 识别失败 -->
    <view wx:if="{{errorMsg && !scanning}}" class="error-tip">{{errorMsg}}</view>
  </block>

  <loading visible="{{scanning}}" text="识别中…" />
</view>
