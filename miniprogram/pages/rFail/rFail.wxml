<view class="page">
  <!-- 失败图标 -->
  <view class="fail-icon">
    <view class="fail-circle">
      <text class="fail-mark">!</text>
    </view>
  </view>

  <!-- 提示语 -->
  <view class="fail-title">未能识别该建筑</view>
  <view class="fail-sub">为您推荐以下热门景点</view>

  <!-- 推荐建筑列表 -->
  <view class="recommend-list" wx:if="{{recommendList.length}}">
    <view
      class="rec-card"
      wx:for="{{recommendList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <image class="rec-img" src="{{item._img}}" mode="aspectFill"></image>
      <view class="rec-info">
        <view class="rec-name">{{item.name}}</view>
        <view class="rec-en">{{item.englishName}}</view>
      </view>
      <view class="rec-arrow">›</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:elif="{{loaded}}">
    <text>暂无推荐建筑</text>
  </view>

  <!-- 操作按钮 -->
  <view class="btn-group">
    <view class="btn-primary" bindtap="reScan">再拍一次</view>
    <view class="btn-secondary" bindtap="goHome">返回首页</view>
  </view>
</view>
