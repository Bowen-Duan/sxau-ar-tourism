/* 全局字体设置 */
page, view, text, button, input, textarea {
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif !important;
}

.page {
  min-height: 100vh;
  background: #f6f7fb;
  padding-bottom: 40rpx;
}

/* ===== 页面头部 ===== */
.header {
  padding: 32rpx 28rpx 24rpx;
  background: #ffffff;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2533;
  display: block;
  margin-bottom: 8rpx;
}

.header-sub {
  font-size: 26rpx;
  color: #9aa0af;
}

/* ===== 视频列表 ===== */
.video-list {
  margin-top: 20rpx;
  padding: 0 24rpx;
}

.video-item {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 45, 80, .06);
}

.video-cover {
  width: 240rpx;
  height: 150rpx;
  border-radius: 12rpx;
  background: #eef1f6;
  flex-shrink: 0;
}

.video-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.video-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2533;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.video-sub {
  font-size: 24rpx;
  color: #9aa0af;
  margin-top: 8rpx;
}

.video-stats {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.play-icon {
  font-size: 20rpx;
  margin-right: 8rpx;
  color: #1a9e6e;
}

.view-count {
  font-size: 22rpx;
  color: #9aa0af;
}

/* ===== 加载中 ===== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e5e7eb;
  border-top-color: #1a9e6e;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #9aa0af;
}

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #9aa0af;
}
