/* 全局字体设置 */
page, view, text, button, input, textarea {
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif !important;
}

.page {
  min-height: 100vh;
  background: #f6f7fb;
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* ===== 活动列表 ===== */
.activity-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.activity-item {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(31, 45, 80, .06);
}

.activity-cover {
  width: 100%;
  background: #eef1f6;
  display: block;
}

.activity-info {
  padding: 20rpx 24rpx;
}

.activity-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2533;
}

/* ===== 加载中 ===== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e5e7eb;
  border-top-color: #1a9e6e;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #9aa0af;
}

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #9aa0af;
}
