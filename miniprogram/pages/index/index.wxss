/* 全局字体设置 */
page, view, text, button, input, textarea {
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif !important;
}

.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #10131a;
}

/* ===== 开屏动画 ===== */
.splash-screen {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  animation: splashFadeIn 0.3s ease-out;
}

@keyframes splashFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.splash-circle {
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f0f0f0;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: splashCircleScale 0.6s ease-out;
}

@keyframes splashCircleScale {
  from { 
    transform: scale(0.5);
    opacity: 0;
  }
  to { 
    transform: scale(1);
    opacity: 1;
  }
}

.splash-image {
  width: 100%;
  height: 100%;
  display: block;
}

.splash-loading {
  display: flex;
  align-items: center;
  justify-content: center;
}

.splash-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e5e7eb;
  border-top-color: #1a9e6e;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.splash-text {
  margin-top: 60rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2533;
  letter-spacing: 8rpx;
  animation: splashTextFade 0.8s ease-out 0.3s both;
}

@keyframes splashTextFade {
  from { 
    opacity: 0;
    transform: translateY(20rpx);
  }
  to { 
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== 全屏轮播背景 ===== */
.bg-swiper {
  /* swiper 组件有默认 150px 高度，必须显式指定宽高才会占满全屏 */
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
}

.bg-img {
  display: block;
  width: 100%;
  height: 100%;
}

/* 底部渐变遮罩：保证品牌标题与按钮可读，不影响点击 */
.mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, .30) 0%, rgba(0, 0, 0, 0) 45%, rgba(0, 0, 0, .55) 100%);
  pointer-events: none;
}

.brand {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  box-sizing: border-box;
  padding-left: 48rpx;
  padding-right: 48rpx;
  padding-bottom: 24rpx;
}

.brand-title {
  display: block;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .35);
}

/* 按钮与校名：垂直水平居中 */
.center {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.start-btn {
  width: 360rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, .92);
  color: #1a1f2e;
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
}

.start-btn::after {
  border: none;
}

.school-name {
  margin-top: 28rpx;
  color: #ffffff;
  font-size: 28rpx;
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .45);
}

.retry {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 30rpx;
}

.retry-tip {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, .65);
}
