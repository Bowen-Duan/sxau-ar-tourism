/* 全局字体设置 */
page, view, text, button, input, textarea {
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif !important;
}

.page {
  min-height: 100vh;
  background: #f4f6f8;
  padding-bottom: 30rpx;
}

/* ===== 顶部标题 ===== */
.header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 28rpx 10rpx;
}
.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
}

/* ===== 搜索框 ===== */
.search-bar {
  display: flex;
  align-items: center;
  margin: 10rpx 28rpx 16rpx;
  background: #fff;
  border-radius: 44rpx;
  padding: 8rpx 8rpx 8rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 定位按钮：竖排图标+文字 */
.near-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 64rpx;
  flex-shrink: 0;
  color: #8a8f99;
}
.near-btn.on {
  color: #c8a96e;
}
.near-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: currentColor;
  position: relative;
  margin-bottom: 2rpx;
}
.near-dot::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  opacity: 0.5;
}
.near-text {
  font-size: 18rpx;
  line-height: 1;
  margin-top: 2rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
  color: #1f2329;
  margin-left: 8rpx;
  min-width: 0;
}
.search-ph {
  color: #b0b3b8;
}
.search-clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  color: #b0b3b8;
  font-size: 36rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.search-btn {
  background: #c8a96e;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 14rpx 42rpx;
  border-radius: 36rpx;
  flex-shrink: 0;
}

/* ===== 分类 tab ===== */
.tabs {
  white-space: nowrap;
  padding: 6rpx 20rpx 18rpx;
  box-sizing: border-box;
}
.tab {
  display: inline-block;
  padding: 12rpx 36rpx;
  margin: 0 8rpx;
  font-size: 27rpx;
  color: #555;
  background: #fff;
  border-radius: 32rpx;
}
.tab.on {
  background: #c8a96e;
  color: #fff;
  font-weight: 600;
}

/* ===== CSS columns 瀑布流两列 ===== */
.grid {
  column-count: 2;
  column-gap: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.card {
  break-inside: avoid;
  width: 100%;
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.05);
}
.img-wrap {
  width: 100%;
  height: 280rpx;
  overflow: hidden;
  position: relative;
  background: #eceff2;
}
.card-img {
  width: 100%;
  height: 100%;
  display: block;
}
.vr-tag {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  background: rgba(200, 169, 110, 0.92);
  color: #fff;
  font-size: 20rpx;
  line-height: 1;
  padding: 7rpx 14rpx;
  border-radius: 8rpx;
  letter-spacing: 1rpx;
}
.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  padding: 16rpx 18rpx 0;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-en {
  font-size: 21rpx;
  color: #9aa0a8;
  padding: 8rpx 18rpx 20rpx;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ===== 空状态 ===== */
.empty {
  padding: 160rpx 60rpx;
  text-align: center;
}
.empty-icon {
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}
.empty-pin {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50% 50% 50% 0;
  background: #cfd6dd;
  transform: rotate(-45deg);
  position: relative;
}
.empty-pin::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 30rpx;
  height: 30rpx;
  background: #fff;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}
.empty-text {
  font-size: 28rpx;
  color: #6b7178;
}
.empty-sub {
  font-size: 24rpx;
  color: #a6abb2;
  margin-top: 14rpx;
}

/* ===== 底部状态 ===== */
.list-footer {
  text-align: center;
  font-size: 24rpx;
  color: #a6abb2;
  padding: 16rpx 0 30rpx;
}
