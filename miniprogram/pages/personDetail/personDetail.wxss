/* 全局字体设置 */
page, view, text, button, input, textarea {
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif !important;
}

/* pages/personDetail/personDetail.wxss */
.person-detail {
  min-height: 100vh;
  background: #f5f6fa;
}

/* 顶部背景 */
.hero {
  position: relative;
  width: 100%;
  height: 420rpx;
  overflow: hidden;
}
.hero-bg {
  width: 100%;
  height: 100%;
  filter: blur(30rpx);
  transform: scale(1.3);
  opacity: 0.8;
}
.hero-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(245,246,250,0.9));
}

/* 人物信息卡片 */
.info-card {
  position: relative;
  margin: -140rpx 24rpx 0;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
  z-index: 10;
}
.avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  border: 5rpx solid #fff;
  box-shadow: 0 6rpx 20rpx rgba(201,169,110,0.3);
  flex-shrink: 0;
  background: #f0f0f0;
}
.name-box {
  flex: 1;
  margin-left: 28rpx;
}
.name {
  font-size: 42rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}
.dates {
  font-size: 26rpx;
  color: #c9a96e;
  display: block;
  background: #faf6ee;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
}

/* 区块卡片 */
.section-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.05);
}
.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.title-bar {
  width: 8rpx;
  height: 36rpx;
  background: linear-gradient(to bottom, #d4af37, #c9a96e);
  border-radius: 4rpx;
  margin-right: 16rpx;
}
.title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.content {
  font-size: 28rpx;
  color: #444;
  line-height: 1.9;
}
.content /deep/ p {
  margin-bottom: 24rpx;
  text-indent: 2em;
  color: #444;
}

/* 底部留白 */
.bottom-space {
  height: 80rpx;
}
