/* 全局字体设置 */
page, view, text, button, input, textarea {
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif !important;
}

.page {
  min-height: 100vh;
  background: #f6f7fb;
  box-sizing: border-box;
  padding: 24rpx 24rpx 60rpx;
}

.tag-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.tag-item {
  padding: 12rpx 36rpx;
  border-radius: 32rpx;
  background: #ffffff;
  color: #666666;
  font-size: 28rpx;
  border: 2rpx solid #e8ecf5;
}

.tag-active {
  background: #315efb;
  color: #ffffff;
  border-color: #315efb;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card {
  width: 342rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, .06);
}

.card-img {
  display: block;
  width: 342rpx;
  height: 342rpx;
  background: #eef1f6;
}

.card-name {
  display: block;
  padding: 20rpx 20rpx 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1f2e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-meta {
  display: flex;
  gap: 12rpx;
  padding: 0 20rpx 20rpx;
}

.badge {
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.badge-scenic {
  color: #315efb;
  background: #f0f4ff;
}

.badge-ip {
  color: #b45e1f;
  background: #fff4e8;
}

.badge-official {
  color: #1a9e6e;
  background: #e8f8f1;
}

.badge-user {
  color: #8a8f9e;
  background: #f0f1f5;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  color: #8a8f9e;
  font-size: 28rpx;
}

.empty-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #b3b8c6;
}
