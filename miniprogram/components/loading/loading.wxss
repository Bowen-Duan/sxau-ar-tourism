.mask {
  position: fixed;
  z-index: 99;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, .25);
}

.box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 48rpx;
  color: #666;
  background: #fff;
  border-radius: 16rpx;
}

.spinner {
  width: 44rpx;
  height: 44rpx;
  border: 6rpx solid #e8ecf5;
  border-top-color: #315efb;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.box-text {
  margin-top: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
