/* app.wxss - 全局样式 */
page {
  height: 100%;
  background: #f6f7fb;
  color: #1c1c1e;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif !important;
  font-size: 28rpx;
}

/* 强制所有元素使用系统字体 */
view, text, button, input, textarea, label, navigator, image, swiper, scroll-view, picker, switch, slider, progress, icon, rich-text, cover-view, cover-image {
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif !important;
  box-sizing: border-box;
}

/* 英文文本强制使用Helvetica Neue */
.spot-name, .spot-en, .action-title, .stat-text, .section-count, .title-text, .lang-text, .map-title, .map-name, .map-address, .info-label, .info-value, .section-title, .person-name, .person-date, .person-brief, .empty-text, .loading-text, .error-text, .action-label, .action-text {
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif !important;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 32rpx;
}

.card {
  padding: 40rpx 32rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .05);
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1c1c1e;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif !important;
}

.desc {
  display: block;
  margin-top: 24rpx;
  color: #8e8e93;
  line-height: 1.7;
}

.status {
  display: block;
  margin-top: 32rpx;
  padding: 20rpx;
  color: #007aff;
  background: #f2f2f7;
  border-radius: 12rpx;
}

button {
  margin-top: 32rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif !important;
}
